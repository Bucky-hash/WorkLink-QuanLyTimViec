<?xml version="1.0" encoding="utf-8"?>
<!-- Chip lọc: đang chọn nền #EFFAE8 viền xanh nhạt, chưa chọn nền trắng viền #E4EAE6. Cao 32, bo 16. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wl_primary_light" />
            <stroke android:width="1dp" android:color="@color/wl_primary_chip" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/wl_employer_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
