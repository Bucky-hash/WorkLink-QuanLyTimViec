<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: nút "Xem hồ sơ" nền + viền #EFFAE8, bo 8 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wl_primary_chip">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wl_primary_light" />
            <stroke android:width="1dp" android:color="@color/wl_primary_light" />
            <corners android:radius="@dimen/wl_radius_chip" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/wl_radius_chip" />
        </shape>
    </item>
</ripple>
