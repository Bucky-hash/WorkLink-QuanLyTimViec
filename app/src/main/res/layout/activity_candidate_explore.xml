<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/candidate_bg_screen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_candidate_explore_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bnv_candidate_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Header: Xin chào, BaoPhuc. + Nút bộ lọc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_candidate_greeting_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/candidate_greeting_prefix"
                        android:textColor="@color/candidate_text_secondary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_candidate_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/candidate_default_user_name"
                        android:textColor="@color/candidate_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_candidate_filter_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_candidate_search_box"
                    android:contentDescription="@string/candidate_cd_filter"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/candidate_text_primary" />
            </LinearLayout>

            <!-- Ô tìm kiếm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_candidate_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/candidate_cd_search_icon"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/candidate_text_hint" />

                <EditText
                    android:id="@+id/et_candidate_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/candidate_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/candidate_text_primary"
                    android:textColorHint="@color/candidate_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Hàng Chip 1: Tiêu chí đang kích hoạt (Lập trình, Địa điểm, Làm việc từ xa) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_candidate_programming"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_candidate_chip_selected"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/candidate_chip_role_programming"
                        android:textColor="@color/candidate_bg_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_candidate_location"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_candidate_chip_selected"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/candidate_chip_location"
                        android:textColor="@color/candidate_bg_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_candidate_remote"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_candidate_chip_selected"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/candidate_chip_remote"
                        android:textColor="@color/candidate_bg_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Hàng Chip 2: Bộ lọc mở rộng (Công ty, Loại công việc, Phạm vi lương) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_candidate_company"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_candidate_chip_normal"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/candidate_chip_company"
                        android:textColor="@color/candidate_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_candidate_job_type"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_candidate_chip_normal"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/candidate_chip_job_type"
                        android:textColor="@color/candidate_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_candidate_salary"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_candidate_chip_normal"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/candidate_chip_salary_range"
                        android:textColor="@color/candidate_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Mục 1: Đề xuất cho bạn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_candidate_recommended_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/candidate_section_recommended"
                    android:textColor="@color/candidate_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_candidate_recommended_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/candidate_action_see_all"
                    android:textColor="@color/candidate_green_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_candidate_recommended_jobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_candidate_recommended_job" />

            <!-- Mục 2: Cập nhật mới -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_candidate_latest_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/candidate_section_latest"
                    android:textColor="@color/candidate_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_candidate_latest_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/candidate_action_see_all"
                    android:textColor="@color/candidate_green_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_candidate_latest_jobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_candidate_latest_job" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bnv_candidate_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/candidate_bg_white"
        app:itemIconTint="@color/selector_candidate_bottom_nav"
        app:itemTextColor="@color/selector_candidate_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_candidate_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>