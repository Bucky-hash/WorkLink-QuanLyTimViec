<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Shortcut" ~83x58: ô icon 32x30 (nền #EFFAE8, bo 9) + nhãn 10 Medium căn giữa, cách 5 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_employer_shortcut_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minHeight="58dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_employer_shortcut_icon">

        <ImageView
            android:id="@+id/shortcut_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/wl_primary_dark" />
    </FrameLayout>

    <TextView
        android:id="@+id/shortcut_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.Worklink.Employer.ShortcutLabel" />
</LinearLayout>
