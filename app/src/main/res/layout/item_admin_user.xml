<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/wl_surface"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar -->
    <TextView
        android:id="@+id/tv_admin_user_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_admin_user_avatar"
        android:gravity="center"
        android:textColor="@color/wl_primary_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Thông tin người dùng -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_admin_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wl_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_admin_user_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/wl_text_secondary"
            android:textSize="11sp" />

        <!-- Vai trò -->
        <TextView
            android:id="@+id/tv_admin_user_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_admin_user_role"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textColor="@color/wl_primary_dark"
            android:textSize="10sp" />

        <!-- Trạng thái -->
        <TextView
            android:id="@+id/tv_admin_user_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_admin_user_role"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textColor="@color/wl_primary_dark"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Mũi tên -->
    <TextView
        android:id="@+id/tv_admin_user_arrow"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="›"
        android:textColor="@color/wl_text_secondary"
        android:textSize="25sp" />

</LinearLayout>
