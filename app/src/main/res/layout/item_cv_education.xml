<?xml version="1.0" encoding="utf-8"?>
<!-- Một khối học vấn: các trường cách nhau 16 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/divider_cv_16"
    android:orientation="vertical"
    android:showDividers="middle">

    <com.example.worklink.ui.candidate.cv.CvField
        android:id="@+id/edu_school"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cvLabel="@string/cv_label_school" />

    <com.example.worklink.ui.candidate.cv.CvField
        android:id="@+id/edu_major"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cvLabel="@string/cv_label_major" />

    <com.example.worklink.ui.candidate.cv.CvField
        android:id="@+id/edu_degree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cvEndIcon="@drawable/ic_cv_field_chevron_down"
        app:cvKind="picker"
        app:cvLabel="@string/cv_label_degree" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.example.worklink.ui.candidate.cv.CvField
            android:id="@+id/edu_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cvEndIcon="@drawable/ic_cv_field_calendar_days"
            app:cvKind="picker"
            app:cvLabel="@string/cv_label_start" />

        <com.example.worklink.ui.candidate.cv.CvField
            android:id="@+id/edu_end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            app:cvEndIcon="@drawable/ic_cv_field_calendar_days"
            app:cvKind="picker"
            app:cvLabel="@string/cv_label_end" />
    </LinearLayout>

    <com.example.worklink.ui.candidate.cv.CvField
        android:id="@+id/edu_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cvKind="multiline"
        app:cvLabel="@string/cv_label_achievement"
        app:cvMinLines="2" />
</LinearLayout>
