<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma: "Nhà tuyển dụng - Trang chủ" (375x812).
    Cột nội dung rộng 343 (lề 16), cách status bar 12, khoảng cách giữa các khối 16.
    Chừa đáy 80dp để thẻ cuối không bị nút chat nổi (55dp + cách nav 4dp) che mất.
    Các khối lặp (thống kê, lối tắt, hồ sơ mới) được đổ dữ liệu từ EmployerHomeFragment.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/employer_home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/wl_screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/wl_screen_padding"
        android:paddingBottom="80dp">

        <!-- ============ Lời chào: logo công ty · tên công ty · chuông ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/company_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_employer_avatar"
                android:clickable="true"
                android:contentDescription="@string/cd_company_avatar"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_emp_building_avatar"
                    android:tint="@color/wl_primary_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/employer_home_greeting_hint"
                    android:textAppearance="@style/TextAppearance.Worklink.Employer.GreetingHint" />

                <TextView
                    android:id="@+id/company_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Worklink.Employer.CompanyName" />
            </LinearLayout>

            <!--
                Vùng chạm 48x48 (Figma vẽ 32x34), tâm trùng nhau. Lề âm giữ nguyên vị trí
                nhìn thấy: sát mép phải cột nội dung và không làm hàng cao thêm.
            -->
            <FrameLayout
                android:id="@+id/notification_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="-1dp"
                android:layout_marginEnd="-8dp"
                android:layout_marginBottom="-1dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_notifications"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_emp_bell"
                    android:tint="@color/wl_ink" />

                <TextView
                    android:id="@+id/notification_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_employer_bell_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="14dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Worklink.Employer.BellCount"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ Thống kê tuyển dụng: lưới 2 x 2 ============ -->
        <LinearLayout
            android:id="@+id/summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <!-- ============ Tiện ích tuyển dụng: lưới 4 x 2 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:text="@string/employer_home_shortcuts_title"
            android:textAppearance="@style/TextAppearance.Worklink.Employer.SectionTitle" />

        <LinearLayout
            android:id="@+id/shortcut_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- ============ Hồ sơ mới nhất ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/employer_home_latest_applicants_title"
                android:textAppearance="@style/TextAppearance.Worklink.Employer.SectionTitle" />

            <!-- Đệm 8dp để dễ chạm, bù bằng lề âm nên chữ vẫn nằm đúng chỗ như Figma -->
            <TextView
                android:id="@+id/view_all_applicants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-8dp"
                android:layout_marginBottom="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:padding="8dp"
                android:text="@string/employer_home_view_all"
                android:textAppearance="@style/TextAppearance.Worklink.Employer.Link" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/applicant_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
