<?xml version="1.0" encoding="utf-8"?>
<!--
  Figma: "Ứng viên - Tạo CV" (375x3208).
  Nội dung cuộn: padding 16, các khối cách nhau 16. Thanh thao tác cố định phía dưới (nền trắng, viền trên #E5E7EB).
  Nút chat nổi nằm trên thanh thao tác, cách 12 và cách mép phải 16.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wl_bg_screen"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/cv_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="80dp"
                android:showDividers="middle">

                <!-- Tiêu đề trang: thanh điều hướng, cách phần giới thiệu 20 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_cv_back"
                            style="@style/Widget.Worklink.BackButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/cv_brand"
                            android:textAppearance="@style/TextAppearance.Worklink.AuthBrand" />

                        <TextView
                            android:id="@+id/tv_cv_save_draft_top"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cv_save_draft_top"
                            android:textAppearance="@style/TextAppearance.Worklink.AuthLink" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cv_title"
                            android:textAppearance="@style/TextAppearance.Worklink.CvTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/cv_subtitle"
                            android:textAppearance="@style/TextAppearance.Worklink.CvDescription" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/cv_required_note"
                            android:textAppearance="@style/TextAppearance.Worklink.Caption" />
                    </LinearLayout>
                </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_user"
                    app:tint="@color/wl_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cv_section_personal"
                    android:textAppearance="@style/TextAppearance.Worklink.CvSectionTitle" />
            </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/cv_avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_cv_avatar"
                            android:contentDescription="@string/cd_cv_avatar"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Worklink.Circle" />

                        <TextView
                            android:id="@+id/cv_avatar_initials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textAppearance="@style/TextAppearance.Worklink.CvAvatar" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/cv_change_photo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cv_camera"
                                app:tint="@color/wl_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/cv_change_photo"
                                android:textAppearance="@style/TextAppearance.Worklink.AuthLink" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/cv_photo_format"
                            android:textAppearance="@style/TextAppearance.Worklink.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_cv_name" />

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_full_name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.example.worklink.ui.candidate.cv.CvField
                        android:id="@+id/cv_birth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cvEndIcon="@drawable/ic_cv_field_calendar_days"
                        app:cvKind="picker"
                        app:cvLabel="@string/cv_label_birth" />

                    <com.example.worklink.ui.candidate.cv.CvField
                        android:id="@+id/cv_gender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        app:cvEndIcon="@drawable/ic_cv_field_chevron_down"
                        app:cvKind="picker"
                        app:cvLabel="@string/cv_label_gender" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cv_mail"
                    app:tint="@color/wl_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cv_section_contact"
                    android:textAppearance="@style/TextAppearance.Worklink.CvSectionTitle" />
            </LinearLayout>

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_email"
                    app:cvEndIcon="@drawable/ic_cv_field_mail"
                    app:cvInputType="email" />

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_phone"
                    app:cvEndIcon="@drawable/ic_cv_field_phone"
                    app:cvInputType="phone" />

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_address"
                    app:cvEndIcon="@drawable/ic_cv_field_map_pin" />

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_website"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_website"
                    app:cvEndIcon="@drawable/ic_cv_field_link"
                    app:cvInputType="uri" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cv_target"
                    app:tint="@color/wl_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cv_section_position"
                    android:textAppearance="@style/TextAppearance.Worklink.CvSectionTitle" />
            </LinearLayout>

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_target_position" />

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_objective"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvLabel="@string/cv_label_objective"
                    app:cvHelper="@string/cv_objective_helper"
                    app:cvKind="multiline"
                    app:cvMinLines="4" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cv_graduation_cap"
                    app:tint="@color/wl_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cv_section_education"
                    android:textAppearance="@style/TextAppearance.Worklink.CvSectionTitle" />
            </LinearLayout>

                <LinearLayout
                    android:id="@+id/cv_education_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_cv_16"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_education"
                    style="@style/Widget.Worklink.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/cv_add_education"
                    app:icon="@drawable/ic_cv_plus"
                    app:iconSize="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_briefcase"
                    app:tint="@color/wl_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cv_section_experience"
                    android:textAppearance="@style/TextAppearance.Worklink.CvSectionTitle" />
            </LinearLayout>

                <LinearLayout
                    android:id="@+id/cv_experience_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_cv_16"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_experience"
                    style="@style/Widget.Worklink.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/cv_add_experience"
                    app:icon="@drawable/ic_cv_plus"
                    app:iconSize="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_cv_16"
                android:orientation="vertical"
                android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cv_award"
                    app:tint="@color/wl_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cv_section_skills"
                    android:textAppearance="@style/TextAppearance.Worklink.CvSectionTitle" />
            </LinearLayout>

                <com.example.worklink.ui.candidate.cv.CvField
                    android:id="@+id/cv_skill_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cvEndIcon="@drawable/ic_cv_field_plus"
                    app:cvHint="@string/cv_hint_skill"
                    app:cvLabel="@string/cv_label_add_skill" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cv_skill_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

                <!-- Mục bổ sung -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_section"
                        style="@style/Widget.Worklink.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/cv_add_section"
                        app:icon="@drawable/ic_cv_plus"
                        app:iconSize="18dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/cv_add_section_hint"
                        android:textAppearance="@style/TextAppearance.Worklink.Caption" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.example.worklink.core.ui.ChatFab
            android:id="@+id/cv_chat_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp" />
    </FrameLayout>

    <!-- Thao tác CV: đệm 16, các hàng cách nhau 12 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cv_action_bar"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cv_save_draft"
                style="@style/Widget.Worklink.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/cv_action_draft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cv_preview"
                style="@style/Widget.Worklink.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/cv_action_preview"
                app:icon="@drawable/ic_cv_eye"
                app:iconSize="18dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cv_save"
            style="@style/Widget.Worklink.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/cv_action_save"
            app:icon="@drawable/ic_cv_file_check"
            app:iconSize="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/cv_privacy_note"
            android:textAppearance="@style/TextAppearance.Worklink.Caption" />
    </LinearLayout>
</LinearLayout>
