<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma: "Nhà tuyển dụng - Hộp thư" (375x812).
    Cột nội dung lề 16. Chừa đáy 80dp để dòng cuối không bị nút chat nổi che mất.
    Dải đang hoạt động, bộ lọc và danh sách được đổ dữ liệu từ EmployerInboxFragment.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/employer_inbox_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/wl_screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/wl_screen_padding"
        android:paddingBottom="80dp">

        <!-- ============ Tiêu đề + máy ảnh + cuộc trò chuyện mới ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/employer_inbox_title"
                android:textAppearance="@style/TextAppearance.Worklink.Employer.InboxTitle" />

            <!-- Vùng chạm 48x48. Lề âm giữ biểu tượng sát mép phải cột nội dung. -->
            <FrameLayout
                android:id="@+id/action_camera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_inbox_camera"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_emp_camera"
                    android:tint="@color/wl_ink" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/action_new_conversation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_inbox_new_conversation"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_emp_new_message"
                    android:tint="@color/wl_ink" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ Tìm kiếm cuộc trò chuyện ============ -->
        <EditText
            android:id="@+id/search_input"
            style="@style/Widget.Worklink.SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/employer_inbox_search_hint"
            android:importantForAutofill="no" />

        <!-- ============ Đang hoạt động (cuộn ngang) ============ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/active_contacts_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ============ Bộ lọc: Tất cả · Chưa đọc (+ tổng) ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_employer_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:includeFontPadding="false"
                    android:text="@string/employer_inbox_filter_all"
                    android:textAppearance="@style/TextAppearance.Worklink.Employer.InboxFilter"
                    android:textColor="@color/wl_employer_filter_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filter_unread"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_employer_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:includeFontPadding="false"
                    android:text="@string/employer_inbox_filter_unread"
                    android:textAppearance="@style/TextAppearance.Worklink.Employer.InboxFilter"
                    android:textColor="@color/wl_employer_filter_text" />

                <TextView
                    android:id="@+id/filter_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_employer_bell_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="14dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Worklink.Employer.BellCount"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Danh sách cuộc trò chuyện ============ -->
        <LinearLayout
            android:id="@+id/conversation_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/inbox_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Worklink.Employer.InboxPreview"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
