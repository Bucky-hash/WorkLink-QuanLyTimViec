<?xml version="1.0" encoding="utf-8"?>
<!-- TẠM THỜI: màn chọn vai trò để thử điều hướng. Thay bằng luồng Giới thiệu/Đăng nhập khi có. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wl_bg_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dev_pick_role"
        android:textAppearance="@style/TextAppearance.Worklink.Label" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_candidate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/dev_role_candidate" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_employer"
        style="@style/Widget.Worklink.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dev_role_employer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_admin"
        style="@style/Widget.Worklink.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dev_role_admin" />
</LinearLayout>
